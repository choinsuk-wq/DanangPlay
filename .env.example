# Web3Forms Access Key (https://web3forms.com 에서 무료 발급)
# 키를 입력하지 않아도 데모 모드로 안전하게 예약 접수 피드백이 시뮬레이션됩니다.
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# 관리자 수신 이메일 안내용
VITE_ADMIN_EMAIL=admin@danangplay.com

# 카카오톡 채널 상담 URL (기본값 설정되어 있음)
VITE_KAKAO_CHANNEL_URL=https://pf.kakao.com/_example
